{
  "name": "helicarrier-nextjs-postgres-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
